{
  "name": "@idea2app/vue-mobx-prime-ts",
  "version": "2.5.0",
  "private": true,
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "browser-unhandled-rejection": "^1.0.2",
    "echarts-jsx": "^1.3.1",
    "idb-keyval": "^6.2.2",
    "koajax": "^3.1.2",
    "mobx": "^6.15.0",
    "mobx-downloader": "^0.3.1",
    "mobx-restful": "^2.1.4",
    "mobx-vue-helper": "^0.2.5",
    "mobx-vue-lite": "^0.4.3",
    "primevue": "^4.5.4",
    "vue": "^3.5.30",
    "vue-facing-decorator": "^4.0.1",
    "vue-router": "^5.0.3",
    "web-streams-polyfill": "^4.2.0",
    "web-utility": "^4.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@octokit/openapi-types": "^27.0.0",
    "@parcel/packager-raw-url": "~2.16.4",
    "@parcel/transformer-vue": "~2.16.4",
    "@parcel/transformer-webmanifest": "~2.16.4",
    "@types/node": "^24.12.0",
    "@vue/tsconfig": "^0.9.0",
    "buffer": "^6.0.3",
    "husky": "^9.1.7",
    "less": "^4.6.3",
    "lint-staged": "^16.3.3",
    "parcel": "~2.16.4",
    "postcss": "^8.5.8",
    "postcss-modules": "^6.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.2.5",
    "workbox-cli": "^7.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "lmdb",
      "msgpackr-extract",
      "vue-demi"
    ]
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "printWidth": 100
  },
  "lint-staged": {
    "*.{html,md,css,less,json,yml,js,ts,mts,vue}": "prettier --write"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead, IE 11",
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf .parcel-cache/ dist/",
    "start": "npm run clean  &&  parcel src/index.html",
    "pack": "npm run clean  &&  vue-tsc --noEmit  &&  parcel build src/index.html --public-url .",
    "build": "npm run pack  &&  workbox generateSW",
    "test": "lint-staged  &&  tsc --noEmit"
  }
}
